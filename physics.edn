;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a regulatory-filing documentation and
;; logistics-coordination robot performs case-file data entry, appointment
;; scheduling and office-supply coordination (ISCO 3359). It never issues a
;; compliance ruling. Its physical work is filing: lifting filing folders onto
;; shelving, and keeping original filings in a fire-rated records container.
;;
;; The records-container case models one wall of the container as a 1-D slab
;; heated by a fire on its outer face; interior contents and edges are not
;; modelled. Every number without a cited source is marked `estimate`.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3359"
 :cases
 [{:id :filing-folder-to-shelf
   :kind :manipulator
   :procedure "arm lifts a regulatory filing folder from the intake tray onto a filing shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 3.5 :m2-kg 2.5
            :from [0.55 0.05] :to [0.20 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [0.3 1.0 2.0 4.0 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a light collaborative arm (~5 kg class)"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :filings-container-fire
   :kind :thermal
   :procedure "original filings sit in an insulated records container while a room fire heats its outer wall for one hour"
   :params {:conductivity-w-mk 0.15 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 900.0 :h-front-w-m2k 40.0 :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 177.0 :duration-s 3600.0}
   :sweep {:param :thickness-m :values [0.02 0.03 0.04 0.06 0.08]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 record protection: interior must stay at or below 350 F (177 C) during the rated exposure"}
   :boundary {:lo 0.005 :hi 0.20}}]}
